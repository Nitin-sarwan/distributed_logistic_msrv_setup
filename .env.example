# Copy to .env at the repo root and fill in. .env is gitignored — never commit it.

# ── Postgres (shared cluster, one database per service) ───────────────────
# DB_PORT 5433 is the PostgreSQL 18 cluster; 5432 is 17. Pointing at the wrong
# one produces a password-authentication failure, not a missing-table error.
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=

# Legacy root app only. Each service pins its own database name in its config.py
# (user_db, partner_db) so no service can read another's tables.
DB_NAME=postgres

# Override only if a service moves to its own cluster.
# USER_DB_NAME=user_db
# PARTNER_DB_NAME=partner_db
# ORDER_DB_NAME=order_db

# ── Password hashing ──────────────────────────────────────────────────────
# The pepper is the security-relevant one: it lives only here, never in the
# database, so a stolen users/partners table cannot be cracked offline.
STATIC_SALT=
STATIC_PEPPER=

# ── Token cipher ──────────────────────────────────────────────────────────
# SECRET_KEY holds the OpenSSL algorithm name, not key material. These three
# MUST match the Node service exactly or tokens will not cross between them.
PASS_SALT_STATIC=
SECRET_KEY=aes-256-cbc

# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=30
# PASSWORD_RESET_EXPIRE_MINUTES=30

# ── Shared session store (Mongo) ──────────────────────────────────────────
# One collection for every service. Sessions are shared infrastructure; business
# data is not.
MONGO_URI=
MONGO_DB_NAME=common

# ── Gateway -> downstream services ────────────────────────────────────────
USER_SERVICE_URL=http://127.0.0.1:8001
PARTNER_SERVICE_URL=http://127.0.0.1:8002
ORDER_SERVICE_URL=http://127.0.0.1:8003

# /api/geo is served by userServices today. Point this elsewhere the day
# geocoding becomes its own process — no other file changes.
# GEO_SERVICE_URL=http://127.0.0.1:8001

# Browser origins allowed to call the gateway, comma separated. Never "*": the
# frontend sends credentialed requests, and browsers reject a wildcard
# Allow-Origin when Allow-Credentials is true.
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── partnerServices ───────────────────────────────────────────────────────
# Shared secret for /internal/* (Dispatch, ops console). Those paths are not in
# the gateway's routing table, so this is a second lock rather than the only
# one. Empty disables the check — acceptable on a local machine only.
INTERNAL_API_KEY=

# A partner whose last heartbeat is older than this is not offered to Dispatch,
# whatever their status column says.
# PARTNER_LOCATION_STALE_MINUTES=5
# PARTNER_SEARCH_RADIUS_KM=5.0
# PARTNER_SEARCH_LIMIT=20

# ── Geocoding (/api/geo) ──────────────────────────────────────────────────
# Address search and reverse lookup, behind every map in the frontend. No key
# and no account: OpenStreetMap's Nominatim is a free public service.
#
# Its usage policy is the thing to respect. Set a User-Agent that names your
# deployment and a contact address before running anywhere real — traffic
# without one is blocked, and a block takes address search down for everyone.
# GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=distributed-logistic/0.1 (ops@example.com)
# GEOCODER_CONTACT_EMAIL=

# ISO country codes to restrict search to, comma separated. Empty searches the
# whole world; "in" matches this system's six-digit PIN codes.
# GEOCODER_COUNTRY_CODES=in

# One request per second is Nominatim's published limit. Raise only against a
# provider that permits it, or a Nominatim instance you host yourself.
# GEOCODER_MIN_INTERVAL_SECONDS=1.0
# GEOCODER_CACHE_TTL_SECONDS=86400

# Per-IP quota on the public geo endpoints, per minute.
# GEO_RATE_LIMIT_PER_MINUTE=30

# ── orderServices ─────────────────────────────────────────────────────────
# The Order service calls userServices' /internal endpoint to snapshot a
# delivery address, using the same INTERNAL_API_KEY set above.

# Pricing, until the Pricing service exists. A flat base plus a per-km rate on
# the straight-line distance — crude on purpose, and one file to delete later.
# PRICING_BASE_FARE=30
# PRICING_PER_KM=12
# PRICING_MINIMUM_FARE=45
# QUOTE_TTL_MINUTES=15

# Payment, until the Payment service exists. True lets an order authorise its
# own payment, which is how the flow reaches CONFIRMED without a provider.
# MUST be false anywhere real: it is, literally, free deliveries.
# PAYMENT_AUTOCONFIRM=true

# ── Local dev only ────────────────────────────────────────────────────────
# Returns the password-reset token in the API response because there is no mail
# delivery yet. MUST stay false anywhere real — it hands account takeover to
# anyone who can guess an email address.
PASSWORD_RESET_EXPOSE_TOKEN=false
