# Copy to .env at the repo root and fill in. .env is gitignored — never commit it.

# ── Postgres (shared cluster, one database per service) ───────────────────
# DB_PORT 5433 is the PostgreSQL 18 cluster; 5432 is 17. Pointing at the wrong
# one produces a password-authentication failure, not a missing-table error.
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=

# Legacy root app only. Each service pins its own database name in its config.py
# (user_db, partner_db) so no service can read another's tables.
DB_NAME=postgres

# Override only if a service moves to its own cluster.
# USER_DB_NAME=user_db
# PARTNER_DB_NAME=partner_db
# ORDER_DB_NAME=order_db

# ── Password hashing ──────────────────────────────────────────────────────
# The pepper is the security-relevant one: it lives only here, never in the
# database, so a stolen users/partners table cannot be cracked offline.
STATIC_SALT=
STATIC_PEPPER=

# ── Token cipher ──────────────────────────────────────────────────────────
# SECRET_KEY holds the OpenSSL algorithm name, not key material. These three
# MUST match the Node service exactly or tokens will not cross between them.
PASS_SALT_STATIC=
SECRET_KEY=aes-256-cbc

# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=30
# PASSWORD_RESET_EXPIRE_MINUTES=30

# ── Shared session store (Mongo) ──────────────────────────────────────────
# One collection for every service. Sessions are shared infrastructure; business
# data is not.
MONGO_URI=
MONGO_DB_NAME=common

# ── Gateway -> downstream services ────────────────────────────────────────
USER_SERVICE_URL=http://127.0.0.1:8001
PARTNER_SERVICE_URL=http://127.0.0.1:8002
ORDER_SERVICE_URL=http://127.0.0.1:8003

# /api/geo is served by userServices today. Point this elsewhere the day
# geocoding becomes its own process — no other file changes.
# GEO_SERVICE_URL=http://127.0.0.1:8001

# Browser origins allowed to call the gateway, comma separated. Never "*": the
# frontend sends credentialed requests, and browsers reject a wildcard
# Allow-Origin when Allow-Credentials is true.
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── partnerServices ───────────────────────────────────────────────────────
# Shared secret for /internal/* (Dispatch, ops console). Those paths are not in
# the gateway's routing table, so this is a second lock rather than the only
# one. Empty disables the check — acceptable on a local machine only.
INTERNAL_API_KEY=

# A partner whose last heartbeat is older than this is not offered to Dispatch,
# whatever their status column says.
# PARTNER_LOCATION_STALE_MINUTES=5
# PARTNER_SEARCH_RADIUS_KM=5.0
# PARTNER_SEARCH_LIMIT=20

# ── Geocoding (/api/geo) ──────────────────────────────────────────────────
# Address search and reverse lookup, behind every map in the frontend. No key
# and no account: OpenStreetMap's Nominatim is a free public service.
#
# Its usage policy is the thing to respect. Set a User-Agent that names your
# deployment and a contact address before running anywhere real — traffic
# without one is blocked, and a block takes address search down for everyone.
# GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=distributed-logistic/0.1 (ops@example.com)
# GEOCODER_CONTACT_EMAIL=

# ISO country codes to restrict search to, comma separated. Empty searches the
# whole world; "in" matches this system's six-digit PIN codes.
# GEOCODER_COUNTRY_CODES=in

# One request per second is Nominatim's published limit. Raise only against a
# provider that permits it, or a Nominatim instance you host yourself.
# GEOCODER_MIN_INTERVAL_SECONDS=1.0
# GEOCODER_CACHE_TTL_SECONDS=86400

# Per-IP quota on the public geo endpoints, per minute.
# GEO_RATE_LIMIT_PER_MINUTE=30

# ── orderServices ─────────────────────────────────────────────────────────
# The Order service calls userServices' /internal endpoint to snapshot a
# delivery address, using the same INTERNAL_API_KEY set above.

# Pricing is its own service now (see the pricingServices section below). Order
# only needs to know where it is and how long to wait for a quote.
# PRICING_SERVICE_TIMEOUT_SECONDS=2

# Payment, until the Payment service exists. True lets an order authorise its
# own payment, which is how the flow reaches CONFIRMED without a provider.
# MUST be false anywhere real: it is, literally, free deliveries.
# PAYMENT_AUTOCONFIRM=true

# ── Local dev only ────────────────────────────────────────────────────────
# Returns the password-reset token in the API response because there is no mail
# delivery yet. MUST stay false anywhere real — it hands account takeover to
# anyone who can guess an email address.
PASSWORD_RESET_EXPOSE_TOKEN=false

# ── The event spine (Kafka) ───────────────────────────────────────────────
# One broker, one topic, three partitions, keyed by order_id. Start it with
# `docker compose up -d` from the repo root; see docs/EVENTS.md.
#
# This matches the HOST listener in docker-compose.yml. Services run on the host
# as uvicorn processes, so it is 127.0.0.1 and not the container name.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# False lets every service start without a broker: producers keep queueing to
# their outbox and consumers do not run. Useful for working on an HTTP endpoint
# without Docker open — but nothing downstream of an event will happen, so no
# order will ever be dispatched and no notification will ever be written.
KAFKA_ENABLED=true

# Relay tuning. The relay drains each service's outbox onto the topic.
# OUTBOX_POLL_SECONDS=1
# OUTBOX_BATCH_SIZE=100
# OUTBOX_MAX_ATTEMPTS=10

# Consumer tuning. `earliest` means a brand new consumer group reads the topic
# from the beginning — which is what you want the first time a service starts,
# and what makes a wiped notification_db repopulate itself.
# CONSUMER_AUTO_OFFSET_RESET=earliest
# CONSUMER_MAX_POLL_RECORDS=20

# ── Gateway -> new services ───────────────────────────────────────────────
DISPATCH_SERVICE_URL=http://127.0.0.1:8004
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8005

# ── dispatchServices ──────────────────────────────────────────────────────
# One database per service.
# DISPATCH_DB_NAME=dispatch_db
#
# Dispatch calls partnerServices' /internal/* with the INTERNAL_API_KEY above:
# once to find candidates, once to claim the driver who accepts.
# PARTNER_SERVICE_TIMEOUT_SECONDS=3
#
# How long a driver has to answer before the offer moves to the next candidate.
# The most user-visible number in the platform: too short and drivers cannot
# reach their phone, too long and a customer waits through a queue of people who
# were never going to answer.
# OFFER_TTL_SECONDS=30
#
# How wide to look, and how far to widen when nobody is in range.
# SEARCH_RADIUS_KM=5
# SEARCH_LIMIT=20
# SEARCH_WIDEN_FACTOR=2
# SEARCH_MAX_RADIUS_KM=15
#
# Two independent give-up conditions; whichever comes first ends the search with
# dispatch.search_failed.
# SEARCH_DEADLINE_SECONDS=180
# MAX_OFFERS_PER_ORDER=10
# EMPTY_SEARCH_BACKOFF_SECONDS=15
#
# How often the background loop looks for expiring offers and waiting searches.
# WORKER_TICK_SECONDS=1

# ── orderServices, continued ──────────────────────────────────────────────
# What happens when Dispatch reports that it found nobody. True cancels the
# order with a reason, which releases the payment authorisation and tells the
# customer to try again. False leaves it in SEARCHING_PARTNER for an operator —
# reasonable only if someone is actually watching.
# CANCEL_ON_DISPATCH_FAILURE=true

# ── notificationServices ──────────────────────────────────────────────────
# NOTIFICATION_DB_NAME=notification_db
#
# The outbound channels. Both are logging stubs until the RabbitMQ email and
# push workers exist — on by default so the log shows exactly what a real
# deployment would send. In-app is not switchable: it is the stored row, and the
# feed the frontend reads.
# EMAIL_ENABLED=true
# PUSH_ENABLED=true
#
# The badge count stops here so a neglected account does not cost a full table
# count on every poll. The app renders "99+" past it.
# UNREAD_COUNT_CAP=99
# FEED_DEFAULT_LIMIT=30
# FEED_MAX_LIMIT=100

# ── pricingServices ───────────────────────────────────────────────────────
# Read by the gateway (public /api/pricing) and by Order (binding quotes).
PRICING_SERVICE_URL=http://127.0.0.1:8006
# PRICING_DB_NAME=pricing_db
#
# Nothing asks a routing engine which roads exist, so fares are charged on the
# straight line times this. 1.0 the day a real router is wired in.
# ROAD_DISTANCE_FACTOR=1.3
# QUOTE_TTL_MINUTES=15
# ESTIMATE_DEFAULT_WEIGHT_KG=1
